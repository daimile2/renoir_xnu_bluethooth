+/* One EDL command on the H4 link; the event (up to 2048 bytes) is logged raw. */
+static int bt_edl(vm_offset_t uart,uint8_t request,const char *name)
+{
+    bt_wr(uart,0xd4c,7);bt_wr(uart,0xd30,(uint32_t)(BT_IOVA+0x1000));bt_wr(uart,0xd34,(uint32_t)((BT_IOVA+0x1000)>>32));
+    bt_wr(uart,0xd38,0);bt_wr(uart,0xd3c,2048);
+    const uint8_t cmd[]={0x01,0x00,0xfc,0x01,request};
+    for(unsigned i=0;i<sizeof(cmd);++i) *(volatile uint8_t *)(bts.nc+i)=cmd[i];
+    __asm__ volatile("dsb sy" ::: "memory");
+    bt_wr(uart,0x270,sizeof(cmd));bt_wr(uart,0x600,1u<<27);
+    bt_wr(uart,0xc4c,7);bt_wr(uart,0xc30,(uint32_t)BT_IOVA);bt_wr(uart,0xc34,(uint32_t)(BT_IOVA>>32));
+    bt_wr(uart,0xc38,1);bt_wr(uart,0xc3c,sizeof(cmd));
+    unsigned ms;
+    for(ms=0;ms<10000 && !(rd(uart,0xc40)&1);++ms) bt_sleep_ms(1);
+    uint32_t txs=rd(uart,0xc40);bt_wr(uart,0xc44,txs);bt_wr(uart,0x618,rd(uart,0x610));
+    printf("STAR BT TX: %s done=%u ms=%u tx_irq=%#x geni=%#x\n",name,txs&1,ms,txs,rd(uart,0x40));
+    if(!(txs&1)) return ETIMEDOUT;
+    for(ms=0;ms<10000 && !(rd(uart,0xd40)&3);++ms) bt_sleep_ms(1);  /* DMA_DONE | EOT */
+    uint32_t rxs=rd(uart,0xd40),len=rd(uart,0xd54);bt_wr(uart,0xd44,rxs);
+    printf("STAR BT RX: %s irq=%#x len=%u ms=%u s_irq=%#x\n",name,rxs,len,ms,rd(uart,0x640));
+    if(!(rxs&3)) return ETIMEDOUT;
+    bt_hex("RX EVENT",bts.nc+0x1000,len>2048?2048:len);
+    return 0;
 }
